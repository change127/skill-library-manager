{
  "name": "skill-library-manager",
  "version": "1.0.0",
  "private": true,
  "description": "桌面版 Skill 管理器",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.skill-library-manager",
    "productName": "Skill 管理器",
    "artifactName": "Skill-Manager-${version}.${ext}",
    "asar": true,
    "files": [
      "desktop/main.mjs",
      "desktop/config.mjs",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable"
    }
  }
}
